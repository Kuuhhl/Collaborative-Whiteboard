{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/build",
			"!**/dist",
			"!.terraform",
			"!infra/terraform",
			"!backend/.cache"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	}
}
