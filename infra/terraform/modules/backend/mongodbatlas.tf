resource "mongodbatlas_project" "project" {
  name   = local.name
  org_id = var.atlas_org_id
}

# M0 shared cluster, atlas free tier (512 MB storage).
resource "mongodbatlas_advanced_cluster" "cluster" {
  project_id   = mongodbatlas_project.project.id
  name         = "whiteboard"
  cluster_type = "REPLICASET"

  # specs have to match these to get the free tier
  replication_specs = [{
    region_configs = [{
      provider_name         = "TENANT"
      backing_provider_name = "AWS"
      region_name           = var.atlas_region
      priority              = 7
      electable_specs = {
        instance_size = "M0"
      }
    }]
  }]
}

# database user whose password is generated by terraform (see locals.tf).
resource "mongodbatlas_database_user" "app" {
  project_id         = mongodbatlas_project.project.id
  username           = local.mongo_db_user
  password           = random_password.mongo_password.result
  auth_database_name = "admin"

  roles {
    role_name     = "readWriteAnyDatabase"
    database_name = "admin"
  }
}

# allow 0.0.0.0/0 because cloud run uses dynamic egress IPs.
resource "mongodbatlas_project_ip_access_list" "cloud_run" {
  project_id = mongodbatlas_project.project.id
  cidr_block = "0.0.0.0/0"
  comment    = "Allow Cloud Run egress (demo)"
}
